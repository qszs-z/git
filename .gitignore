# 依赖目录（npm install 生成，体积大、可重建，不需要提交）
node_modules/

# 环境变量文件（含密钥/密码，绝不能提交）
.env
.env.*
!.env.example

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 构建产物
dist/
build/

# 测试覆盖率报告
coverage/

# 操作系统生成的杂项文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器配置（如需团队共享 settings，可删除下面两行）
.vscode/
.idea/
